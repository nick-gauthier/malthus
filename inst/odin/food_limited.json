{"version":"1.5.11","config":{"base":"food_limited","include":{"names":["pgamma_cpp"],"data":[{"names":["pgamma_cpp"],"declarations":["double pgamma_cpp(double x, double shape, double scale);"],"definitions":["double pgamma_cpp(double x, double shape, double scale) {\n  if (x <= 0) return 0.0;\n\n  // Normalize x by scale\n  x = x / scale;\n  double p = shape;\n  double z = x;\n\n  // Handle small z case\n  if (z <= 0) return 0;\n\n  // Use series expansion\n  double sum = 1.0 / p;\n  double term = sum;\n  for (int i = 1; i < 1000; i++) {\n    term *= z / (p + i);\n    sum += term;\n    if (fabs(term) < fabs(sum) * 1e-14) break;\n  }\n\n  // Calculate log of gamma function\n  double loggamma = lgamma(p);  // Using standard C++ lgamma function\n  double result = sum * exp(-z + p * log(z) - loggamma);\n  if (result > 1) result = 1;\n  if (result < 0) result = 0;\n  return result;\n}"],"filename":["/Users/nick/UFL Dropbox/Nicolas Gauthier/Projects/malthus/inst/odin/pgamma.cpp"]}]},"custom":null},"meta":{"internal":"internal","user":"user","state":"state","result":"state_next","output":"output","time":"step","initial_time":"initial_step"},"features":{"continuous":false,"discrete":true,"mixed":false,"has_array":true,"has_output":false,"has_user":true,"has_delay":false,"has_interpolate":false,"has_stochastic":true,"has_data":false,"has_compare":false,"has_include":true,"has_debug":false,"has_derivative":false,"initial_time_dependent":false},"data":{"elements":[{"name":"aging_up","location":"internal","storage_type":"double","rank":1,"dimnames":{"length":"dim_aging_up","dim":[],"mult":[]},"stage":"time"},{"name":"alpha","location":"internal","storage_type":"double","rank":0,"dimnames":null,"stage":"user"},{"name":"births_by_age","location":"internal","storage_type":"double","rank":1,"dimnames":{"length":"dim_births_by_age","dim":[],"mult":[]},"stage":"time"},{"name":"cal_max","location":"internal","storage_type":"double","rank":0,"dimnames":null,"stage":"user"},{"name":"ca